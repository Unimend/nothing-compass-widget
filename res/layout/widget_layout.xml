<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <FrameLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="9dp"
        android:layout_marginTop="10.5dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="10.5dp"
        android:background="@drawable/widget_card_background"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/background_matrix"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/compass_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_description" />

        <ImageView
            android:id="@+id/click_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_description" />

    </FrameLayout>

</FrameLayout>
